# تنظیمات اجرای Node.js روی cPanel
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# حالت دمو در محیط واقعی حتماً خاموش باشد
DEMO_MODE=false
# مسیر ذخیره‌سازی خارج از public_html، با مجوز نوشتن
DATA_DIR=./data
# توکن تصادفی حداقل ۲۴ کاراکتر برای نصب اولیه (openssl rand -hex 24)
INSTALL_TOKEN=
# در صورت اجرای پشت Passenger / پراکسی HTTPS
TRUST_PROXY=1
# سقف فایل بارگذاری‌شده، مگابایت
MAX_UPLOAD_MB=5
