# تنظیمات اجرای Node.js روی cPanel
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# حالت دمو در محیط واقعی حتماً خاموش باشد
DEMO_MODE=false
# مسیر ذخیره‌سازی خارج از public_html، با مجوز نوشتن
DATA_DIR=./data
# توکن تصادفی حداقل ۲۴ کاراکتر برای نصب اولیه (openssl rand -hex 24)
INSTALL_TOKEN=
# در صورت اجرای پشت Passenger / پراکسی HTTPS
TRUST_PROXY=1
# سقف فایل بارگذاری‌شده، مگابایت
MAX_UPLOAD_MB=5
# نصب در ساب‌دایرکتوری، مثلاً /school (خالی = ریشه). هم برای build و هم برای اجرا لازم است.
BASE_PATH=
# پل پیامک/ایمیل از «تنظیمات ← پیامک و ایمیل» داخل برنامه تنظیم می‌شود و نیازی به متغیر محیطی ندارد.
# --- فروش ماژولار (docs/LICENSING.md) ---
# off = همهٔ ماژول‌ها باز (توسعه/دمو). on = فقط ماژول‌های لایسنس + ماژول‌های پایه.
LICENSE_MODE=off
# کلید عمومی فروشنده؛ یا کل PEM در یک خط با \n، یا مسیر فایل:
LICENSE_PUBLIC_KEY=
LICENSE_PUBLIC_KEY_PATH=
# مسیر فایل لایسنس (پیش‌فرض: DATA_DIR/license.json). برای لایسنس داخل متغیر از LICENSE_KEY استفاده کنید.
LICENSE_FILE=
LICENSE_KEY=
